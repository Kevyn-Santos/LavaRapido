# Configuração local do backend executado pelo Docker Desktop no Windows.
# O host.docker.internal permite ao container alcançar o MySQL instalado no Windows.
ENV_DEV=LOCAL
LOCAL_DB_URL=jdbc:mysql://host.docker.internal:3306/lava_rapido
LOCAL_USER=fast_splash_app
LOCAL_PASS=COLOQUE_A_SENHA_DO_USUARIO_MYSQL
